<?xml version="1.0" encoding="utf-8"?>
<!--
    ================================================================================
    DAFA ARDIANTO - 3420230004 - TEKNIK INFORMATIKA
    ================================================================================
    LAYOUT UTAMA: activity_main.xml (Seluruh Teks Dipanggil Dari strings.xml)
    ================================================================================
    Catatan Implementasi:
    1. Tanpa Hardcoded Strings: Seluruh teks (Judul, Subjudul, Label Input, Hint,
       Tombol, Hasil, Deskripsi Ikon, dan Footer) memanggil resource @string/nama_string.
    2. Lengkap Atribut ID: Setiap komponen memiliki ID unik.
    3. Tanpa Background Drawable: Seluruh gaya tampilan dipanggil dari themes.xml.
    ================================================================================
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg_light_sage"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_horizontal">

        <!--
            ========================================================================
            DAFA ARDIANTO - 3420230004 - TEKNIK INFORMATIKA
            HEADER: LOGO UTAMA
            ========================================================================
        -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@string/desc_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/pompomlogo"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp" />

        <!--
            ========================================================================
            DAFA ARDIANTO - 3420230004 - TEKNIK INFORMATIKA
            JUDUL DAN SUBJUDUL APLIKASI
            ========================================================================
        -->
        <TextView
            android:id="@+id/tvJudulUtama"
            style="@style/HeaderTitleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_kalkulator"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvSubjudulUtama"
            style="@style/HeaderSubtitleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_kalkulator"
            android:layout_marginBottom="10dp" />

        <!--
            ========================================================================
            DAFA ARDIANTO - 3420230004 - TEKNIK INFORMATIKA
            KARTU UTAMA FORM INPUT
            ========================================================================
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMainForm"
            style="@style/GlassCardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/containerFormInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!--
                    INPUT 1: JARAK TEMPUH (KM)
                -->
                <LinearLayout
                    android:id="@+id/layoutHeaderJarak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:id="@+id/imgIconJarak"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_route"
                        android:contentDescription="@string/desc_icon_jarak"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvLabelJarak"
                        style="@style/InputLabelStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_jarak" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilJarak"
                    style="@style/GlassInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etJarak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_jarak"
                        android:textColorHint="@color/glass_text_hint_dark"
                        android:textColor="@color/glass_text_title_dark"
                        android:inputType="numberDecimal"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--
                    INPUT 2: KONSUMSI BBM (KM/LITER)
                -->
                <LinearLayout
                    android:id="@+id/layoutHeaderKonsumsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:id="@+id/imgIconKonsumsi"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_local_gas_station"
                        android:contentDescription="@string/desc_icon_konsumsi"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvLabelKonsumsi"
                        style="@style/InputLabelStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_konsumsi" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilKonsumsi"
                    style="@style/GlassInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKonsumsi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_konsumsi"
                        android:textColorHint="@color/glass_text_hint_dark"
                        android:textColor="@color/glass_text_title_dark"
                        android:inputType="numberDecimal"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--
                    INPUT 3: HARGA BBM PER LITER (RP)
                -->
                <LinearLayout
                    android:id="@+id/layoutHeaderHarga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:id="@+id/imgIconHarga"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_attach_money"
                        android:contentDescription="@string/desc_icon_harga"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvLabelHarga"
                        style="@style/InputLabelStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_harga" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHargaBbm"
                    style="@style/GlassInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHargaBbm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_harga"
                        android:textColorHint="@color/glass_text_hint_dark"
                        android:textColor="@color/glass_text_title_dark"
                        android:inputType="numberDecimal"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--
                    TOMBOL HITUNG ESTIMASI BIAYA
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHitung"
                    style="@style/GlassButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/btn_hitung"
                    app:icon="@drawable/ic_calculate"
                    app:iconPadding="8dp"
                    app:iconGravity="textStart" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            ========================================================================
            DAFA ARDIANTO - 3420230004 - TEKNIK INFORMATIKA
            KARTU HASIL ESTIMASI
            ========================================================================
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHasilEstimasi"
            style="@style/GlassResultCardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/containerHasil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/layoutHeaderHasil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:id="@+id/imgIconHasil"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_analytics"
                        android:contentDescription="@string/desc_icon_hasil"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvHeaderHasil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/header_hasil"
                        android:textColor="@color/army_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHasil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_hasil"
                    android:textColor="@color/glass_text_title_dark"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            ========================================================================
            DAFA ARDIANTO - 3420230004 - TEKNIK INFORMATIKA
            FOOTER MAHASISWA
            ========================================================================
        -->
        <LinearLayout
            android:id="@+id/layoutFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvFooterNama"
                style="@style/FooterTitleStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/student_name_nim" />

            <TextView
                android:id="@+id/tvFooterProdi"
                style="@style/FooterSubtitleStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/student_prodi"
                android:layout_marginTop="1dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>